# Salin berkas ini jadi .env.local lalu isi nilainya.
# .env.local sudah masuk .gitignore dan tidak akan pernah ter-commit.

# --- e.id Verifier API ---
# Diberikan panitia. Pilih base URL sesuai kredensial yang Anda terima.
EID_BASE_URL=
EID_CLIENT_ID=
EID_CLIENT_SECRET=

# --- s.id ---
SID_API_KEY=
# Isi 1 untuk mematikan permintaan ke s.id, misalnya saat mengembangkan di
# laptop. Kosongkan atau hapus baris ini di server.
SID_MATIKAN=

# --- Aplikasi ---
APP_BASE_URL=
# Alamat email tujuan laporan penyalahgunaan, tampil di Halaman B.
# Kalau kosong, dipakai abuse@cekusaha.id.
KONTAK_LAPORAN=
